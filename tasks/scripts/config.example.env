# Copia este archivo a config.env (gitignored) y ajusta lo que necesites.
# install_service.sh lo hace automáticamente si config.env no existe todavía.

REPO_URL=https://github.com/madrono-ucm/madronoTFM.git
GITHUB_REPO=madrono-ucm/madronoTFM
REPO_PATH=/home/ubuntu/repos/madronoTFM-agent
GIT_BASE_BRANCH=main
GIT_AUTHOR_NAME="Claude Agent"
GIT_AUTHOR_EMAIL=claude-agent@gmail.com

# Cada cuánto comprueba el demonio si hay trabajo nuevo o si ya toca un reintento.
POLL_INTERVAL_SECONDS=60

# Backoff exponencial para fallos tipo "límite de uso alcanzado":
# delay = min(BACKOFF_BASE_SECONDS * BACKOFF_FACTOR^(attempts-1), BACKOFF_MAX_SECONDS) +- jitter
BACKOFF_BASE_SECONDS=300
BACKOFF_FACTOR=2
BACKOFF_MAX_SECONDS=14400
BACKOFF_JITTER_PCT=0.2

CLAUDE_BIN=/home/ubuntu/.local/bin/claude
CLAUDE_MODEL=sonnet
CLAUDE_FALLBACK_MODEL=
# Tope de gasto en USD por invocación (por intento de tarea). Si se agota se trata
# como fallo duro (failed), no como reintento por rate-limit.
CLAUDE_MAX_BUDGET_USD=6.00
# Tiempo máximo (segundos) que se deja trabajar a claude en una tarea antes de
# considerarlo colgado y tratarlo como fallo reintentable.
CLAUDE_TIMEOUT_SECONDS=5400

GH_BIN=/usr/bin/gh
# Método de merge usado solo para tareas con force: true (merge | squash | rebase).
GH_MERGE_METHOD=squash
# Antes de auto-fusionar un PR force: true, el demonio espera a que la CI
# termine en verde (tarea 101). Tope de esa espera en segundos; si se supera,
# el PR no se fusiona y queda para merge manual.
GH_CHECKS_TIMEOUT_SECONDS=900
LOG_LEVEL=INFO
