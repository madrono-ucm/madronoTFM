    classDef bronze fill:#fdf3e7,stroke:#e8a23c,color:#333;
    classDef gate fill:#fbeced,stroke:#d1495b,color:#333;
    classDef silver fill:#eef3fb,stroke:#3d6ce0,color:#333;
    classDef gold fill:#eef7f0,stroke:#66a182,color:#333;
    classDef reject fill:#f5f5f5,stroke:#999,color:#666,stroke-dasharray: 4 3;
    class B bronze;
    class GX gate;
    class SV silver;
    class GD,AT,N4,MD gold;
    class RJ reject;
