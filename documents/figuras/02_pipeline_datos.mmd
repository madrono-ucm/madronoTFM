    GX -->|lote inválido| RJ["Lote rechazado<br/>no progresa de capa<br/>(informe persistido)"]
    SV -->|"AWS Glue<br/>trigger CONDITIONAL"| GD[("Gold<br/>agregado horario<br/>o diario")]
