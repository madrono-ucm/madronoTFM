flowchart LR
    EQ["Equipo<br/>(2 personas)"] -->|"escribe"| TASK["Tarea .md<br/>contexto · alcance ·<br/>criterios de aceptación"]

    subgraph Q1["Cola de construcción — madrono-agent (EC2, 24/7)"]
        direction TB
        TASK --> AG["Agente ejecuta<br/>la especificación"]
        AG --> PR["rama + Pull Request"]
        PR --> CI{"CI en verde?"}
        CI -->|"no"| STOP["blocked / failed<br/>la cola entera se detiene"]
        CI -->|"sí, force=true"| AUTO["merge automático"]
        CI -->|"sí, sin force"| HUM["revisión humana"]
        HUM --> AUTO
    end

    STOP -->|"una persona lo revisa"| EQ
    AUTO --> DONE[("tarea done")]

    subgraph Q2["Cola de QA — sesión interactiva, independiente"]
        direction TB
        QT["Tarea VIC_*/VIKT_*<br/>verificar contra el sistema real"] --> QA["Se ejecuta y compara<br/>con el estado real"]
        QA --> BUG{"¿discrepancia<br/>o bug real?"}
        BUG -->|"sí"| NEW["nueva tarea FIL_*"]
        BUG -->|"no"| REP[("informe doc/VIC-NN")]
    end

    DONE --> QT
    NEW -.-> TASK

    classDef eq fill:#fff7e0,stroke:#c8a600,color:#333;
    classDef spec fill:#eef3fb,stroke:#3d6ce0,color:#333;
    classDef build fill:#f5eefb,stroke:#8a5fc9,color:#333;
    classDef gate fill:#fbeced,stroke:#d1495b,color:#333;
    classDef qa fill:#eef7f0,stroke:#66a182,color:#333;
    class EQ eq;
    class TASK spec;
    class AG,PR,HUM,AUTO build;
    class CI,STOP gate;
    class QT,QA,BUG,NEW,REP,DONE qa;
